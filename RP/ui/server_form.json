          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "((((((#title_text - 'NaLandia » Classes') - 'NaLandia » Mon clan') - 'NaLandia » Menu') - 'NaLandia » Administration') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      }

{
  "namespace": "server_form",

  "_comment": "MENUS À BOUTONS (ActionForm — /sn:menu, hub, admin, Classes, États, Clans, Monde, Mines, Métiers…) — reskin NaLandia v19.5. Fichier à l'emplacement vanilla (ui/server_form.json = écrasement), SPLIT en plusieurs fichiers : socle dans ui/om_base.json, variante « fiches » (textures + chaîne de titres) dans ui/om_sheets.json, formulaires à champs dans ui/om_forms.json. DEUX MISES EN PAGE COMPLÈTEMENT DIFFÉRENTES, choisies par le TITRE du formulaire (seul canal lisible : Bedrock partage cet unique écran long_form entre TOUS les menus à boutons) : (1) console_layout = menus hub/admin et leurs sous-menus → colonne de tuiles fines à gauche (32 px) + grand panneau de texte à droite, panneaux argentés, fond cuir ; (2) sheet_layout = menus de contenu Classes/États/Clans/Monde/Mines/Métiers/Mes infos → silhouette inversée : BANDEAU DE TEXTE EN HAUT (panneau doré pleine largeur) puis GRANDES CARTES EMPILÉES (44 px, cadre or + barre d'accent dorée) en bas, fond vert émeraude à double filet. Les deux mises en page ne partagent NI la géométrie NI le contrôle d'entrée (dynamic_button vs dynamic_card). ⚠️ NE JAMAIS renommer le binding #form_button_text (binding_name_override) : le nom est consommé et $button_text ne résout plus rien → tous les libellés deviennent vides (bug v19.3, corrigé en v19.4). Le bouton retour est identifié par son ICÔNE (#form_button_texture), comme le fait le vanilla.",

  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },

  "main_screen_content": {
    "type": "panel",
    "size": [0, 0],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@om_forms.custom_form"
          }
        }
      }
    ]
  },

  "long_form@common_dialogs.main_panel_no_buttons": {
    "$title_text_color": [0.98, 0.86, 0.52],
    "$title_size": ["100% - 15px", 10],
    "$title_max_size": ["100% - 15px", 10],
    "size": [420, 240],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.long_form_panel",
    "layer": 2,
    "$custom_background": "om_sheets.form_background"
  },

  "long_form_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%"],
    "orientation": "vertical",
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "console_layout": {
          "type": "panel",
          "size": ["100%", "100%"],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#title_text",
              "binding_name_override": "#om_title"
            },
            {
              "source_property_name": "((#om_title = 'NaLandia » Classes') or (#om_title = 'NaLandia » Classe') or (#om_title = 'NaLandia » Ma voie') or (#om_title = 'NaLandia » Confirmer') or (#om_title = 'NaLandia » États') or (#om_title = 'NaLandia » Clan') or (#om_title = 'NaLandia » Mon clan') or (#om_title = 'NaLandia » Membres du clan') or (#om_title = 'NaLandia » Membre') or (#om_title = 'NaLandia » Inviter') or (#om_title = 'NaLandia » Drapeau') or (#om_title = 'NaLandia » Dissoudre le clan') or (#om_title = 'NaLandia » Créer un clan') or (#om_title = 'NaLandia » Le Monde') or (#om_title = 'NaLandia » Mines') or (#om_title = 'NaLandia » Métiers') or (#om_title = 'NaLandia » Mes infos'))",
              "target_property_name": "#om_sheet"
            },
            {
              "source_property_name": "(not #om_sheet)",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "columns": {
                "type": "stack_panel",
                "size": ["100%", "100%"],
                "orientation": "horizontal",
                "controls": [
                  { "sidebar@server_form.sidebar_column": {} },
                  { "body@server_form.body_column": {} }
                ]
              }
            }
          ]
        }
      },
      {
        "sheet_layout": {
          "type": "panel",
          "size": ["100%", "100%"],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_name": "#title_text",
              "binding_name_override": "#om_title"
            },
            {
              "source_property_name": "((#om_title = 'NaLandia » Classes') or (#om_title = 'NaLandia » Classe') or (#om_title = 'NaLandia » Ma voie') or (#om_title = 'NaLandia » Confirmer') or (#om_title = 'NaLandia » États') or (#om_title = 'NaLandia » Clan') or (#om_title = 'NaLandia » Mon clan') or (#om_title = 'NaLandia » Membres du clan') or (#om_title = 'NaLandia » Membre') or (#om_title = 'NaLandia » Inviter') or (#om_title = 'NaLandia » Drapeau') or (#om_title = 'NaLandia » Dissoudre le clan') or (#om_title = 'NaLandia » Créer un clan') or (#om_title = 'NaLandia » Le Monde') or (#om_title = 'NaLandia » Mines') or (#om_title = 'NaLandia » Métiers') or (#om_title = 'NaLandia » Mes infos'))",
              "target_property_name": "#om_sheet"
            },
            {
              "source_property_name": "#om_sheet",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "sheet_body_scroll@om_base.om_scroll_pane": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": ["100% - 12px", "38% - 9px"],
                "offset": [6, 6],
                "$scroll_background_image_control": "om_sheets.sheet_pane_image",
                "$scrolling_content": "server_form.body_content"
              }
            },
            {
              "sheet_cards_scroll@om_base.om_scroll_pane": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": ["100% - 12px", "62% - 9px"],
                "offset": [6, "38% + 3px"],
                "$scroll_background_image_control": "om_sheets.sheet_pane_image",
                "$scrolling_content": "server_form.sheet_cards_panel"
              }
            }
          ]
        }
      }
    ]
  },

  "sidebar_column": {
    "type": "panel",
    "size": [128, "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "sidebar_scroll@om_base.om_scroll_pane": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "size": ["100% - 12px", "100% - 12px"],
          "offset": [6, 6],
          "$scrolling_content": "server_form.sidebar_buttons_panel"
        }
      }
    ]
  },

  "sidebar_buttons_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%c"],
    "offset": [0, 2],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "sheet_cards_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%c"],
    "offset": [2, 0],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.dynamic_card",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "body_column": {
    "type": "panel",
    "size": ["fill", "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body_scroll@om_base.om_scroll_pane": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "size": ["100% - 12px", "100% - 12px"],
          "offset": [6, 6],
          "$scrolling_content": "server_form.body_content"
        }
      }
    ]
  },

  "body_content": {
    "type": "stack_panel",
    "size": ["100% - 8px", "100%c"],
    "offset": [4, 2],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body_label": {
          "type": "label",
          "color": [0.93, 0.92, 0.90],
          "size": ["100%", "default"],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "text": "#form_text",
          "shadow": false,
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ]
        }
      }
    ]
  },

  "dynamic_button": {
    "type": "panel",
    "size": ["100%", 32],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "back_slot": {
          "type": "panel",
          "size": ["100%", 32],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "source_property_name": "((#texture = 'textures/ui/om_btn_back') or (#texture = 'textures/ui/om_btn_back.png'))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "back_button@om_base.om_text_button": {
                "$pressed_button_name": "button.form_button_click",
                "$button_image": "common.empty_panel",
                "$button_text": "§r",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": ["100%", 32],
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ],
                "controls": [
                  {
                    "arrow@om_base.om_back_arrow": {
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "offset": [6, 0]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "button_slot": {
          "type": "panel",
          "size": ["100%", 32],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "source_property_name": "(not ((#texture = 'textures/ui/om_btn_back') or (#texture = 'textures/ui/om_btn_back.png')))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "form_button@om_base.om_text_button": {
                "$pressed_button_name": "button.form_button_click",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": ["100%", 32],
                "$button_text": "#form_button_text",
                "$button_text_binding_type": "collection",
                "$button_text_grid_collection_name": "form_buttons",
                "$button_text_max_size": ["100%", 20],
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "dynamic_card": {
    "type": "panel",
    "size": ["100%", 42],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "card_back_slot": {
          "type": "panel",
          "size": ["100%", 42],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "source_property_name": "((#texture = 'textures/ui/om_btn_back') or (#texture = 'textures/ui/om_btn_back.png'))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "card_back_button@om_base.om_text_button": {
                "$pressed_button_name": "button.form_button_click",
                "$button_image": "common.empty_panel",
                "$button_text": "§r",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": ["100%", 42],
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ],
                "controls": [
                  {
                    "arrow@om_base.om_back_arrow": {
                      "size": [30, 30],
                      "anchor_from": "left_middle",
                      "anchor_to": "left_middle",
                      "offset": [10, 0]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "card_slot": {
          "type": "panel",
          "size": ["100%", 42],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "source_property_name": "(not ((#texture = 'textures/ui/om_btn_back') or (#texture = 'textures/ui/om_btn_back.png')))",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "card@om_base.om_card_button": {
                "$pressed_button_name": "button.form_button_click",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": ["100%", 42],
                "$button_text": "#form_button_text",
                "$button_text_binding_type": "collection",
                "$button_text_grid_collection_name": "form_buttons",
                "$button_text_max_size": ["100% - 30px", 24],
                "$button_font_size": "large",
                "bindings": [
                  {
                    "binding_type": "collection_details",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "dynamic_label@settings_common.option_group_spaced_label": {
    "$text": "#form_button_text",
    "$text_bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "dynamic_header": {
    "type": "label",
    "color": [0.98, 0.86, 0.52],
    "size": ["100% - 8px", "default"],
    "offset": [4, 2],
    "layer": 3,
    "text": "#form_button_text",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  }
}

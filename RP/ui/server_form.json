  "om_class_card": {
    "$tex|default": "textures/ui/om_card",
    "$slot|default": [88, 146],
    "type": "panel",
    "size": "$slot",
    "controls": [
      {
        "om_cc_click": {
          "type": "button",
          "size": ["100%", "100%"],
          "layer": 1,
          "default_control": "om_cc_off",
          "hover_control": "om_cc_hover",
          "pressed_control": "om_cc_press",
          "sound_name": "random.click",
          "controls": [
            {
              "om_cc_off": {
                "type": "image",
                "texture": "$tex",
                "size": ["100%", "100%"]
              }
            },
            {
              "om_cc_hover": {
                "type": "image",
                "texture": "textures/ui/om_glow_hover",
                "size": ["100%", "100%"]
              }
            },
            {
              "om_cc_press": {
                "type": "image",
                "texture": "textures/ui/om_glow_press",
                "size": ["100%", "100%"]
              }
            }
          ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ],
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.form_button_click",
              "mapping_type": "pressed",
              "button_up": true
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.form_button_click",
              "mapping_type": "focused"
            }
          ]
        }
      },
      {
        "om_cc_name": {
          "type": "label",
          "text": "#form_button_text",
          "localize": false,
          "size": ["100% - 8px", "default"],
          "offset": [4, 12],
          "layer": 9,
          "text_alignment": "center",
          "color": [1, 1, 1],
          "shadow": true,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]

          "$child_control": "server_form.long_form_panel",
          "layer": 2,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(((#title_text - 'NaLandia » Classes') - 'NaLandia » Mon clan') = #title_text)",
              "target_property_name": "#visible"
            }

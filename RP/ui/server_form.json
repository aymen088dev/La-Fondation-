{
  "namespace": "server_form",

  "_comment": "MENUS À BOUTONS (ActionForm — /sn:menu, hub, admin, États, Mines…) — reskin NaLandia v19.2. Fichier à l'emplacement vanilla (ui/server_form.json = écrasement), SPLIT en plusieurs fichiers : le socle (boutons, panneaux, fonds) vit dans ui/om_base.json (namespace om_base, déclaré dans _ui_defs.json) et les FORMULAIRES à champs vivent dans ui/om_forms.json. Ce fichier porte la variante « MENUS » : grand cadre CUIR sombre à cadre OR (om_base.om_ornate_background), titre or, tuiles charbon à surbrillance dorée, panneaux déroulants argentés, sidebar à gauche / body à droite. Structure sinon identique au vanilla (factories, bindings, collections).",

  "third_party_server_screen@common.base_screen": {
    "$screen_content": "server_form.main_screen_content",
    "button_mappings": [
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.menu_exit",
        "mapping_type": "global"
      }
    ]
  },

  "main_screen_content": {
    "type": "panel",
    "size": [0, 0],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@om_forms.custom_form"
          }
        }
      }
    ]
  },

  "long_form@common_dialogs.main_panel_no_buttons": {
    "$title_text_color": [0.98, 0.86, 0.52],
    "$title_size": ["100% - 15px", 10],
    "$title_max_size": ["100% - 15px", 10],
    "size": [340, 200],
    "$text_name": "#title_text",
    "$title_text_binding_type": "none",
    "$child_control": "server_form.long_form_panel",
    "layer": 2,
    "$custom_background": "om_base.om_ornate_background"
  },

  "long_form_panel": {
    "type": "stack_panel",
    "size": ["100%", "100%"],
    "orientation": "vertical",
    "layer": 1,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "columns": {
          "type": "stack_panel",
          "size": ["100%", "100%"],
          "orientation": "horizontal",
          "controls": [
            { "sidebar@server_form.sidebar_column": {} },
            { "body@server_form.body_column": {} }
          ]
        }
      }
    ]
  },

  "sidebar_column": {
    "type": "panel",
    "size": [114, "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "sidebar_scroll@om_base.om_scroll_pane": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "size": ["100% - 4px", "100% - 4px"],
          "offset": [2, 2],
          "$scrolling_content": "server_form.sidebar_buttons_panel"
        }
      }
    ]
  },

  "sidebar_buttons_panel": {
    "type": "stack_panel",
    "size": ["100% - 4px", "100%c"],
    "offset": [2, 0],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "server_form.dynamic_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "body_column": {
    "type": "panel",
    "size": ["fill", "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body_scroll@om_base.om_scroll_pane": {
          "anchor_to": "top_left",
          "anchor_from": "top_left",
          "size": ["100% - 6px", "100% - 4px"],
          "offset": [3, 2],
          "$scrolling_content": "server_form.body_content"
        }
      }
    ]
  },

  "body_content": {
    "type": "stack_panel",
    "size": ["100% - 8px", "100%c"],
    "offset": [4, 0],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body_label": {
          "type": "label",
          "color": [0.93, 0.92, 0.90],
          "size": ["100%", "default"],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "text": "#form_text",
          "shadow": false,
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ]
        }
      }
    ]
  },

  "dynamic_button@om_base.om_text_button": {
    "$pressed_button_name": "button.form_button_click",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": ["100%", 32],
    "$button_text": "#form_button_text",
    "$button_text_binding_type": "collection",
    "$button_text_grid_collection_name": "form_buttons",
    "$button_text_max_size": ["100%", 20],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "dynamic_label@settings_common.option_group_spaced_label": {
    "$text": "#form_button_text",
    "$text_bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "dynamic_header": {
    "type": "label",
    "color": [0.98, 0.86, 0.52],
    "size": ["100% - 8px", "default"],
    "offset": [4, 2],
    "layer": 3,
    "text": "#form_button_text",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  }
}

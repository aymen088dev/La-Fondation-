                "anchor_to": "center"
              }
            }
          ]
        }
      },
      {
        "om_admin_root": {
          "type": "panel",
          "size": ["100%", "100%"],
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#title_text = 'NaLandia » Administration')",
              "target_property_name": "#visible"

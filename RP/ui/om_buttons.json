{
  "_comment": "Reskin OpenMontage des boutons communs (utilisés par les formulaires serveur : submit, boutons de liste…). Boutons noirs bordés style captures, avec états hover/pressed.",

  "namespace": "om_buttons",

  "light_text_button": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "om_bg_default": {
              "type": "image",
              "texture": "textures/ui/om_btn",
              "size": ["100%", "100%"],
              "layer": -1,
              "anchor_from": "center",
              "anchor_to": "center"
            }
          },
          {
            "om_bg_hover": {
              "type": "image",
              "texture": "textures/ui/om_btn_hover",
              "size": ["100%", "100%"],
              "layer": -1,
              "anchor_from": "center",
              "anchor_to": "center",
              "bindings": [
                {
                  "binding_name": "#hovered",
                  "binding_name_override": "#visible"
                }
              ]
            }
          },
          {
            "om_bg_pressed": {
              "type": "image",
              "texture": "textures/ui/om_btn_press",
              "size": ["100%", "100%"],
              "layer": 0,
              "anchor_from": "center",
              "anchor_to": "center",
              "bindings": [
                {
                  "binding_name": "#pressed",
                  "binding_name_override": "#visible"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}

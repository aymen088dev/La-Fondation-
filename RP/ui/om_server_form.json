        "binding_name": "#custom_radio_text",
        "binding_type": "collection",
        "binding_collection_name": "custom_dropdown"
      },
      {
        "binding_type": "collection_details"
      }
    ]
  },

  "custom_multiselect": {
    "type": "stack_panel",
    "size": ["100%", "100%c"],
    "orientation": "vertical",
    "layer": 2,
    "controls": [
      {
        "header": {
          "type": "panel",
          "size": ["100%", 30],
          "controls": [
            {
              "toggle@settings_common.options_dropdown_toggle_control": {
                "$toggle_view_binding_name": "custom_multiselect_section",
                "$toggle_name": "custom_multiselect",
                "$toggle_state_binding_name": "#custom_multiselect",
                "$toggle_binding_type": "collection",
                "$toggle_grid_collection_name": "custom_form",
                "$option_enabled_binding_name": "",
                "$enabled": true,
                "$options_dropdown_toggle_label_binding": "#custom_text",
                "$options_dropdown_toggle_label_binding_type": "collection",
                "$options_dropdown_toggle_label_binding_collection_name": "custom_form"
              }
            }
          ]
        }
      },
      {
        "options_panel": {
          "type": "stack_panel",
          "size": ["100%", "100%c"],
          "orientation": "vertical",
          "bindings": [
            {
              "binding_name": "#custom_multiselect",
              "binding_type": "collection",
              "binding_collection_name": "custom_form",
              "binding_name_override": "#visible"
            }
          ],
          "controls": [
            {
